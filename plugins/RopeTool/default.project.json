{
	"name": "RopeTool",
	"globIgnorePaths": [
		"**/*.spec.luau"
	],
	"tree": {
		"$className": "Folder",
		"Src": {
			"$path": "src",
			"PluginGui": {
				"$path": "../../libraries/PluginGui"
			}
		},
		"Packages": {
			"$path": {
				"optional": "../../Packages"
			}
		},
		"Loader": {
			"$path": "loader.server.luau"
		}
	}
}
